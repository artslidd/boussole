// Small reusable pieces: buttons, the difficulty picker, the dial and the compass rose.

import { Theme } from "theme.slint";
import { Level } from "types.slint";

// Visible keyboard focus: an ink ring just outside the control.
export component FocusRing inherits Rectangle {
    in property <bool> active;
    in property <length> corner: 12px;
    // Size of the control the ring surrounds
    in property <length> target-width;
    in property <length> target-height;
    visible: root.active;
    x: -5px;
    y: -5px;
    width: root.target-width + 10px;
    height: root.target-height + 10px;
    border-radius: root.corner + 5px;
    border-width: 2px;
    border-color: Theme.ink;
}

export component PrimaryButton inherits Rectangle {
    in property <string> text;
    callback clicked();
    min-height: 46px;
    min-width: 180px;
    border-radius: 10px;
    border-width: 2px;
    border-color: Theme.ink;
    background: touch.pressed ? Theme.amber-deep : touch.has-hover ? Theme.amber-hover : Theme.amber;
    accessible-role: button;
    accessible-label: root.text;
    accessible-action-default => {
        root.clicked();
    }

    fs := FocusScope {
        key-pressed(event) => {
            if (event.text == Key.Return || event.text == " ") {
                // A held key (auto-repeat) must not press the button again.
                if (!event.repeat) {
                    root.clicked();
                }
                return accept;
            }
            return reject;
        }
        touch := TouchArea {
            mouse-cursor: pointer;
            clicked => {
                fs.focus();
                root.clicked();
            }
        }
    }

    Text {
        width: 100%;
        height: 100%;
        text: root.text;
        color: Theme.ink;
        font-size: 17px;
        font-weight: 600;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    FocusRing {
        active: fs.has-focus;
        corner: 10px;
        target-width: root.width;
        target-height: root.height;
    }
}

export component GhostButton inherits Rectangle {
    in property <string> text;
    callback clicked();
    min-height: 32px;
    min-width: 88px;
    border-radius: 8px;
    background: touch.has-hover ? Theme.rule : transparent;
    accessible-role: button;
    accessible-label: root.text;
    accessible-action-default => {
        root.clicked();
    }

    fs := FocusScope {
        key-pressed(event) => {
            if (event.text == Key.Return || event.text == " ") {
                // A held key (auto-repeat) must not press the button again.
                if (!event.repeat) {
                    root.clicked();
                }
                return accept;
            }
            return reject;
        }
        touch := TouchArea {
            mouse-cursor: pointer;
            clicked => {
                fs.focus();
                root.clicked();
            }
        }
    }

    Text {
        width: 100%;
        height: 100%;
        text: root.text;
        color: Theme.ink-soft;
        font-size: 14px;
        font-weight: 500;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    FocusRing {
        active: fs.has-focus;
        corner: 8px;
        target-width: root.width;
        target-height: root.height;
    }
}

// One option of the difficulty picker.
component LevelCard inherits Rectangle {
    in property <string> title;
    in property <string> description;
    // Example of an arrow label at this level, shown in the roomy layout only.
    in property <string> sample;
    in property <bool> selected;
    in property <bool> compact;
    in property <bool> focused;
    callback clicked();

    border-radius: 12px;
    border-width: 2px;
    border-color: root.selected ? Theme.ink : Theme.rule;
    background: root.selected ? Theme.amber-wash : touch.has-hover ? Theme.chart : transparent;
    min-height: root.compact ? 62px : 84px;
    accessible-role: radio-button;
    accessible-label: root.title + " : " + root.description;
    accessible-checked: root.selected;
    accessible-action-default => {
        root.clicked();
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.clicked();
        }
    }

    HorizontalLayout {
        padding-left: 14px;
        padding-right: 14px;
        padding-top: 8px;
        padding-bottom: 8px;
        spacing: 12px;

        // Radio dot
        VerticalLayout {
            alignment: center;
            Rectangle {
                width: 20px;
                height: 20px;
                border-radius: 10px;
                border-width: 2px;
                border-color: Theme.ink;
                background: Theme.chart;
                Rectangle {
                    visible: root.selected;
                    width: 10px;
                    height: 10px;
                    border-radius: 5px;
                    background: Theme.ink;
                }
            }
        }

        VerticalLayout {
            alignment: center;
            spacing: 2px;
            Text {
                text: root.title;
                color: Theme.ink;
                font-size: 18px;
                font-weight: 600;
            }

            Text {
                text: root.description;
                color: Theme.ink-soft;
                font-size: 14px;
                wrap: word-wrap;
            }
        }

        if !root.compact: VerticalLayout {
            alignment: center;
            Rectangle {
                width: sample-pill.preferred-width + 20px;
                height: 26px;
                border-radius: 13px;
                border-width: 1px;
                border-color: Theme.rule;
                background: Theme.chart;
                sample-pill := Text {
                    text: root.sample;
                    color: Theme.ink;
                    font-size: 14px;
                    font-weight: 600;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
        }
    }

    FocusRing {
        active: root.focused;
        corner: 12px;
        target-width: root.width;
        target-height: root.height;
    }
}

// The two difficulty levels, chosen before each round. Arrow keys switch the level, Enter
// confirms (starts the round).
//
// `guard-on-create`: ignore Enter for a short moment after the picker appears. The picker
// shows up the instant the last guess ends the round, so a key still held down (auto-repeat)
// or a quick double-tap on Enter would otherwise skip the "Bravo !" / "Perdu !" screen.
// A key auto-repeat is always ignored.
export component LevelPicker inherits Rectangle {
    in-out property <Level> level: Level.facile;
    in property <bool> compact;
    in property <bool> stacked: true;
    in property <bool> guard-on-create: false;
    callback chosen(Level);
    callback confirmed();
    public function focus-picker() {
        fs.focus();
    }
    property <bool> guarded: root.guard-on-create;
    // Stacked cards need two rows, side-by-side cards one.
    min-height: root.stacked ? 2 * (root.compact ? 62px : 84px) + 10px : (root.compact ? 62px : 84px);

    Timer {
        interval: 700ms;
        running: root.guarded;
        triggered => {
            root.guarded = false;
        }
    }

    fs := FocusScope {
        key-pressed(event) => {
            if (event.text == Key.LeftArrow || event.text == Key.UpArrow) {
                root.chosen(Level.facile);
                return accept;
            }
            if (event.text == Key.RightArrow || event.text == Key.DownArrow) {
                root.chosen(Level.difficile);
                return accept;
            }
            if (event.text == Key.Return) {
                if (!event.repeat && !root.guarded) {
                    root.confirmed();
                }
                return accept;
            }
            return reject;
        }

        GridLayout {
            spacing: 10px;
            LevelCard {
                row: 0;
                col: 0;
                title: "Facile";
                description: root.compact ? "Distances affichées" : "Distances affichées sur les flèches";
                sample: "Lyon · 392 km";
                selected: root.level == Level.facile;
                compact: root.compact;
                focused: fs.has-focus && root.level == Level.facile;
                clicked => {
                    fs.focus();
                    root.chosen(Level.facile);
                }
            }

            // Below Facile when stacked, next to it otherwise.
            LevelCard {
                row: root.stacked ? 1 : 0;
                col: root.stacked ? 0 : 1;
                title: "Difficile";
                description: root.compact ? "Flèches seules" : "Flèches seules, sans distances";
                sample: "Lyon";
                selected: root.level == Level.difficile;
                compact: root.compact;
                focused: fs.has-focus && root.level == Level.difficile;
                clicked => {
                    fs.focus();
                    root.chosen(Level.difficile);
                }
            }
        }
    }
}

// The dial: a tick ring around a disc that holds the "?" (or the revealed city). The tick
// paths come from Rust (src/board.rs) in a 200 × 200 box and are scaled to the dial's size.
export component DialFace inherits Rectangle {
    // Square: width == height == twice the outer (tick ring) radius.
    in property <string> ticks;
    in property <string> north-tick;
    in property <string> text: "?";
    in property <length> text-size: 40px;
    in property <length> body-diameter: root.width * 0.78;
    in property <color> text-color: Theme.signal;
    in property <color> body-color: Theme.chart;

    Path {
        width: 100%;
        height: 100%;
        viewbox-width: 200;
        viewbox-height: 200;
        commands: root.ticks;
        stroke: Theme.ink;
        stroke-width: 1.5px;
        stroke-line-cap: round;
    }

    Path {
        width: 100%;
        height: 100%;
        viewbox-width: 200;
        viewbox-height: 200;
        commands: root.north-tick;
        stroke: Theme.signal;
        stroke-width: 3px;
        stroke-line-cap: round;
    }

    Rectangle {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        width: root.body-diameter;
        height: root.body-diameter;
        border-radius: self.width / 2;
        border-width: 2.5px;
        border-color: Theme.ink;
        background: root.body-color;

        Text {
            width: parent.width * 0.92;
            height: parent.height;
            x: (parent.width - self.width) / 2;
            text: root.text;
            color: root.text-color;
            font-family: Theme.display-font;
            font-size: root.text-size;
            horizontal-alignment: center;
            vertical-alignment: center;
            wrap: word-wrap;
            overflow: elide;
        }
    }
}

// Small N / E / S / O rose in the corner of the board. 72 × 72, see COMPASS_SIZE in board.rs.
export component CompassRose inherits Rectangle {
    width: 72px;
    height: 72px;
    accessible-role: image;
    accessible-label: "Rose des vents : le nord est en haut";

    // four-point star
    Path {
        width: 100%;
        height: 100%;
        viewbox-width: 72;
        viewbox-height: 72;
        commands: "M 36 17 L 40.5 31.5 L 55 36 L 40.5 40.5 L 36 55 L 31.5 40.5 L 17 36 L 31.5 31.5 Z";
        fill: Theme.ink;
        stroke: Theme.ink;
        stroke-width: 1px;
        stroke-line-join: round;
    }

    // north half of the needle in red
    Path {
        width: 100%;
        height: 100%;
        viewbox-width: 72;
        viewbox-height: 72;
        commands: "M 36 17 L 40.5 31.5 L 36 36 L 31.5 31.5 Z";
        fill: Theme.signal;
        stroke: Theme.signal;
        stroke-width: 1px;
        stroke-line-join: round;
    }

    Text {
        x: 0px;
        y: 0px;
        width: 100%;
        height: 14px;
        text: "N";
        color: Theme.signal-ink;
        font-size: 13px;
        font-weight: 600;
        horizontal-alignment: center;
    }

    Text {
        x: 0px;
        y: parent.height - 14px;
        width: 100%;
        height: 14px;
        text: "S";
        color: Theme.ink-soft;
        font-size: 13px;
        font-weight: 600;
        horizontal-alignment: center;
    }

    Text {
        x: parent.width - 14px;
        y: 0px;
        width: 14px;
        height: 100%;
        text: "E";
        color: Theme.ink-soft;
        font-size: 13px;
        font-weight: 600;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    Text {
        x: 0px;
        y: 0px;
        width: 14px;
        height: 100%;
        text: "O";
        color: Theme.ink-soft;
        font-size: 13px;
        font-weight: 600;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

export component Mark inherits Rectangle {
    // Tiny compass mark in front of the title
    in property <length> size: 26px;
    width: root.size;
    height: root.size;
    Rectangle {
        border-radius: root.size / 2;
        border-width: 2px;
        border-color: Theme.ink;
    }

    Path {
        width: 100%;
        height: 100%;
        viewbox-width: 26;
        viewbox-height: 26;
        commands: "M 13 3.5 L 16.2 13 L 13 13 Z";
        fill: Theme.signal;
        stroke: Theme.signal;
        stroke-width: 1px;
        stroke-line-join: round;
    }

    Path {
        width: 100%;
        height: 100%;
        viewbox-width: 26;
        viewbox-height: 26;
        commands: "M 13 22.5 L 9.8 13 L 13 13 Z";
        fill: Theme.ink;
        stroke: Theme.ink;
        stroke-width: 1px;
        stroke-line-join: round;
    }
}
