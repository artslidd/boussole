// Data shared between the Rust glue (src/app.rs) and the components.

export enum Phase { setup, playing, ended }

export enum Level { facile, difficile }

// The game type offered on the start screen (Devinette is the default).
export enum GameType { devinette, fleches }

// One arrow of the board: SVG path strings in canvas coordinates (computed in Rust).
export struct ArrowView {
    shaft: string,
    head: string,
}

// One label pill of the board, in canvas coordinates.
export struct LabelView {
    text: string,
    x: length,
    y: length,
    width: length,
    height: length,
}

// One row of the guess history.
export struct GuessRow {
    name: string,
    // "312 km", or "Trouvé" for the correct guess
    distance: string,
    // SVG path of a small arrow pointing from the guess towards the answer (20 × 20 box)
    arrow: string,
    // Spoken description of the direction, e.g. "au nord-est"
    direction: string,
    correct: bool,
    // Online Coopération only (the history is shared): who guessed, and their initial for the
    // little badge. Both empty in solo and in Course.
    by: string,
    initial: string,
}

export struct Suggestion {
    name: string,
    // already tried in this round
    tried: bool,
}

// One numbered arrow of the Flèches board: the SVG paths and the label pill (canvas
// coordinates, computed in Rust like BoardView), plus the unit vector of its bearing for
// the polar click zone (the nearest arrow wins).
export struct FlechesOptionView {
    // "1"…"4"
    number: string,
    shaft: string,
    head: string,
    label: LabelView,
    // unit vector of the arrow's bearing (north = up, y grows downwards)
    dir-x: float,
    dir-y: float,
}

// Everything the Flèches board draws, computed in Rust for the current canvas size (pure
// callback `compute-fleches-board`, re-evaluated on resize and on every answer).
export struct FlechesBoardView {
    options: [FlechesOptionView],
    // Dial centre and radii (tick ring, filled disc), in canvas coordinates
    cx: length,
    cy: length,
    outer: length,
    body: length,
    // Origin city name, always known in Flèches
    text: string,
    text-size: length,
    // Radial band in which a click aims at an arrow: from just inside the dial ring to the
    // outer edge of the label ring.
    hit-inner: length,
    hit-outer: length,
    // cos of the widest angle between the pointer and an arrow that still aims at it.
    aim-min-cos: float,
    // Spoken summary of the board for assistive technology
    summary: string,
}

// One line of the Flèches recap: question number, origin → target, right or wrong.
export struct FlechesRecapRow {
    number: int,
    from: string,
    to: string,
    correct: bool,
}

// Everything the round canvas draws, computed in Rust for the current canvas size (pure
// callback `compute-board`, re-evaluated whenever the size or the round changes).
export struct BoardView {
    arrows: [ArrowView],
    labels: [LabelView],
    // Dial centre and radii (tick ring, filled disc), in canvas coordinates
    cx: length,
    cy: length,
    outer: length,
    body: length,
    // "?" while the city is hidden, its name once revealed
    text: string,
    text-size: length,
    revealed: bool,
    // Spoken summary of the board for assistive technology
    summary: string,
}

// ---------------------------------------------------------------------------------------------
// Online mode (see online-state.slint)
// ---------------------------------------------------------------------------------------------

// Which online screen is up.
export enum OnlineScreen { menu, lobby, round, result, podium }

// How to host: on the local network, or over the Internet through a free tunnel.
export enum HostChoice { lan, tunnel }

// Game mode of a room.
export enum RoomMode { course, coop }

// State of the strip in the header: connection trouble, or (for a host) a dead tunnel.
export enum BannerKind { none, reconnecting, lost, tunnel-lost }

// How a player stands in a Course round.
export enum DotStatus { playing, solved, out }

// Extra help shown under the host card.
export enum MenuHelp { none, tunnel-missing }

// A player of the lobby.
export struct PlayerRowView {
    name: string,
    host: bool,
    me: bool,
    connected: bool,
    // For screen readers: "Alice (hôte, vous)"
    description: string,
}

// A line of the live scoreboard (Course) or of the turn order (Coopération): no city names.
export struct ScoreRowView {
    name: string,
    me: bool,
    host: bool,
    connected: bool,
    tries: int,
    status: DotStatus,
    // Coopération: holds the turn
    active: bool,
    description: string,
}

// A line of the end-of-round results.
export struct ResultRowView {
    name: string,
    me: bool,
    solved: bool,
    found: bool,
    // "+496"
    points: string,
    // "1 190"
    total: string,
    // "Lyon · Dijon · Besançon"
    guesses: string,
    description: string,
}

// A line of the final ranking.
export struct RankRowView {
    // "1", "2"…; empty in Coopération
    rank: string,
    name: string,
    me: bool,
    total: string,
    // "3 manches trouvées"
    detail: string,
    first: bool,
}

// An address the host shares, with its copy feedback.
export struct ShareAddressView {
    label: string,
    url: string,
    copied: bool,
    // The tunnel behind this address died: the address no longer works.
    lost: bool,
}
